# ==============================================================================
# StudyGrade Environment Configuration Template
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit your actual '.env' file with production credentials to Git.
# ==============================================================================

# Core Application & Security
# Set DEBUG=False in production. In production, DEBUG=False is enforced by default.
DEBUG=True

# In production (DEBUG=False), SECRET_KEY must be a unique, random 50+ character string.
# Example: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=replace-with-a-unique-secret-key-in-production

# AI Generation (Google AI Studio Gemini API Key)
# Obtain a key at: https://aistudio.google.com/
# If left blank, StudyGrade automatically falls back to built-in NLP cloze extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Configuration
# Option A: Single Database URL (Recommended for Render, Neon, Supabase, Railway):
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require
# Option B: Local SQLite Development (Default for local testing):
USE_SQLITE=True
# Option C: Discrete PostgreSQL settings (When USE_SQLITE=False and DATABASE_URL is not set):
DB_NAME=studygrade_db
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Hostnames & Trusted Origins (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,studygrade.onrender.com,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://studygrade.onrender.com,https://*.onrender.com

# Document Upload & Storage Limits (in bytes)
MAX_UPLOAD_SIZE_BYTES=10485760    # 10 MB per document
MAX_USER_STORAGE_BYTES=52428800   # 50 MB total per student account

# Cloud Object Storage (AWS S3, Cloudflare R2, MinIO)
# Set USE_S3_STORAGE=True to persist uploaded documents outside ephemeral container storage.
USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
# For Cloudflare R2 or MinIO, specify the custom endpoint URL:
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Observability & Logging
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
