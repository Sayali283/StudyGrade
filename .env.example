# ==============================================================================
# StudyGrade Environment Configuration Template
# Copy this file to '.env' and populate with your environment-specific values.
# ==============================================================================

# Security
DEBUG=True
SECRET_KEY=replace-with-a-unique-secret-key-in-production

# AI Generation (Google AI Studio Gemini API Key)
# Leave blank to use built-in intelligent NLP fallback
GEMINI_API_KEY=

# Database Configuration
# Option A (Cloud Database URL):
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname
# Option B (Local SQLite):
USE_SQLITE=True
# Option C (Separate PostgreSQL variables when USE_SQLITE=False):
DB_NAME=studyguard
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Production Hostnames & Trusted Origins (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,study-guard-1.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app
